function phoneFormat(input) {
    // Remove all non-numeric characters
    let digits = input.replace(/\D/g, '');

    // Remove country code if it starts with '1' and is 11 digits
    if (digits.startsWith('1') && digits.length === 11) {
        digits = digits.substring(1);
    }

    // Limit to the first 10 digits
    digits = digits.substring(0, 10);

    let formattedNumber = "";
    const size = digits.length;

    if (size > 0) { formattedNumber = "(" + digits.slice(0, 3); }
    if (size > 3) { formattedNumber += ") " + digits.slice(3, 6); }
    if (size > 6) { formattedNumber += "-" + digits.slice(6); }

    const isValid = digits.length === 10;
    const $button = $(".button.nav-btn.phone-number.v5.text-weight-semi-bold");
    
    if (isValid) {
      $button.removeClass("is-disabled");
      $('.error-input-msg.phone-msg').hide();
    } else {
      $button.addClass("is-disabled");
      $('.error-input-msg.phone-msg').show();
    }

    return formattedNumber
    
}
